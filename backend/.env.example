# =====================================================================
# LAYOVER — backend environment template
# Copy: cp .env.example .env   (Windows: copy .env.example .env)
# NEVER commit the real .env.
# =====================================================================

APP_ENV=development
APP_NAME=LAYOVER API

# --- Supabase ---------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role: full DB access, backend ONLY. Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# --- HTTP -------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
