# =====================================================================
# LAYOVER — root environment template
# Copy this file to `.env` and fill in real values. NEVER commit .env.
# Per-app copies live in frontend/.env.example and backend/.env.example.
# =====================================================================

# --- Backend ---------------------------------------------------------
# Supabase project URL (from Supabase dashboard > Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon key: safe client-side, but still rotates it before demo day
SUPABASE_ANON_KEY=your-anon-key
# Service-role key: BACKEND ONLY. Grants full DB access — never ship to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase Auth JWT issuer URL used to validate bearer tokens
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# Backend CORS: comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Frontend --------------------------------------------------------
# Base URL of the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000
# Same Supabase URL/anon key for the React app
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
